<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RunWorkingDirectory>../..</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.DevUI" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.OpenAI" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MafPlayground.AI.Abstractions/MafPlayground.AI.Abstractions.csproj" />
    <ProjectReference Include="../MafPlayground.Studio/MafPlayground.Studio.csproj" />
    <ProjectReference Include="../MafPlayground.AI.Runtime/MafPlayground.AI.Runtime.csproj" />
    <ProjectReference Include="../MafPlayground.AI.Samples/MafPlayground.AI.Samples.csproj" />
    <ProjectReference Include="../MafPlayground.Observability/MafPlayground.Observability.csproj" />
    <ProjectReference Include="../MafPlayground.Providers.Google/MafPlayground.Providers.Google.csproj" />
    <ProjectReference Include="../MafPlayground.Providers.Ollama/MafPlayground.Providers.Ollama.csproj" />
    <ProjectReference Include="../MafPlayground.Retrieval/MafPlayground.Retrieval.csproj" />
    <ProjectReference Include="../MafPlayground.Retrieval.Postgres/MafPlayground.Retrieval.Postgres.csproj" />
  </ItemGroup>

  <!-- Build-time input only. No npm/Node dependency is introduced at runtime. -->
  <ItemGroup>
    <Content Include="../MafPlayground.Studio.Web/dist/studio/browser/**/*"
             Link="studio/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
