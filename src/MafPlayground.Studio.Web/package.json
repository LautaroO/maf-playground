{
  "name": "studio",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --port 4200 --proxy-config proxy.conf.cjs",
    "build": "ng build && node scripts/licenses.mjs",
    "typecheck": "ngc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.e2e.json",
    "test:unit": "ng test --watch=false && node --test scripts/proxy.test.cjs",
    "test:e2e": "node scripts/e2e.mjs",
    "generate:contracts": "node scripts/contracts.mjs",
    "check:contracts": "node scripts/contracts.mjs --check",
    "format": "prettier --write src scripts \"e2e/**/*.ts\" *.json *.ts *.cjs",
    "check:format": "prettier --check src scripts \"e2e/**/*.ts\" *.json *.ts *.cjs"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "cytoscape": "3.34.4",
    "monaco-editor": "0.57.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "vscode-json-languageservice": "5.7.2",
    "vscode-languageserver-textdocument": "1.0.16"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@playwright/test": "1.64.1",
    "@types/cytoscape": "3.21.9",
    "@types/node": "24.19.2",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "vite": "8.3.5",
    "ajv": "8.20.0"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  }
}
