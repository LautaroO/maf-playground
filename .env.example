# Copy this file to .env and load it into your shell before running a host:
#   cp .env.example .env
#   set -a; source .env; set +a

# Provider-qualified model selector: provider:model
AI_MODEL=ollama:llama3.1:8b

# Ollama provider configuration
AI__PROVIDERS__OLLAMA__ENDPOINT=http://localhost:11434

# OpenTelemetry export is opt-in.
OBSERVABILITY__ENABLED=false
OBSERVABILITY__SERVICENAME=maf-playground-cli
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Local infrastructure ports used by compose.yaml
ASPIRE_DASHBOARD_PORT=18888
OTEL_EXPORTER_OTLP_GRPC_PORT=4317
OTEL_EXPORTER_OTLP_HTTP_PORT=4318

# Local development only. Set to false to require the dashboard login token.
ASPIRE_DASHBOARD_ALLOW_ANONYMOUS=true

# Keep prompts, responses, tool arguments, and tool results out of telemetry.
# Enable only in a secured local development environment.
OBSERVABILITY__AGENTFRAMEWORK__ENABLESENSITIVEDATA=false
